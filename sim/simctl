#!/usr/bin/env bash
# Run the BloomBee simulation CLI with the right Python interpreter.
#
# Preference order:
#   1. $PYTHON (explicit override)
#   2. sim/.venv/bin/python (validation/development environment in this checkout)
#   3. python
#   4. python3
#
# Examples:
#   ./sim/simctl status
#   ./sim/simctl smoke
#   ./sim/simctl logs node-0
#   ./sim/simctl down
set -euo pipefail

cd "$(dirname "$0")/.."

if [[ -n "${PYTHON:-}" ]]; then
  PYTHON_BIN="$PYTHON"
elif [[ -x "sim/.venv/bin/python" ]]; then
  PYTHON_BIN="$PWD/sim/.venv/bin/python"
elif command -v python >/dev/null 2>&1; then
  PYTHON_BIN="python"
elif command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN="python3"
else
  echo "ERROR: no python interpreter found; activate your environment or set PYTHON=..." >&2
  exit 1
fi

exec "$PYTHON_BIN" sim/simctl.py "$@"
